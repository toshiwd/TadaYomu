{
  "expo": {
    "name": "Tadayomu",
    "slug": "Tadayomu",
    "version": "1.3.73",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "./plugins/withReaderControls"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F47B20"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.enish.tadayomu",
      "versionCode": 31,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "http", "host": "ncode.syosetu.com" },
            { "scheme": "https", "host": "ncode.syosetu.com" },
            { "scheme": "http", "host": "syosetu.com" },
            { "scheme": "https", "host": "syosetu.com" },
            { "scheme": "http", "host": "www.syosetu.com" },
            { "scheme": "https", "host": "www.syosetu.com" },
            { "scheme": "http", "host": "yomou.syosetu.com" },
            { "scheme": "https", "host": "yomou.syosetu.com" },
            { "scheme": "http", "host": "novel18.syosetu.com" },
            { "scheme": "https", "host": "novel18.syosetu.com" },
            { "scheme": "http", "host": "syosetu.org" },
            { "scheme": "https", "host": "syosetu.org" }
          ]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            { "mimeType": "text/plain" }
          ]
        }
      ],
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
